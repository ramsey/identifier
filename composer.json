{
    "name": "ramsey/identifier",
    "description": "A PHP library for generating and working with identifiers, including UUIDs, ULIDs, and Snowflakes",
    "license": "LGPL-3.0-or-later",
    "type": "library",
    "keywords": [
        "guid",
        "id",
        "identifier",
        "snowflake",
        "uid",
        "ulid",
        "uuid"
    ],
    "support": {
        "issues": "https://github.com/ramsey/identifier/issues",
        "security": "https://github.com/ramsey/identifier/security/policy"
    },
    "require": {
        "php-64bit": "^8.3",
        "brick/math": "^1.0",
        "identifier/identifier": "^0.6.1",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "captainhook/plugin-composer": "^5.3.3",
        "ergebnis/composer-normalize": "^2.56",
        "hamcrest/hamcrest-php": "^2.1 || ^3.0",
        "mockery/mockery": "^1.6",
        "phpbench/phpbench": "^1.6",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.3.5",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1.1",
        "phpunit/phpunit": "^12.5 || ^13.0",
        "ramsey/coding-standard": "^2.4",
        "ramsey/composer-repl": "^1.5.1",
        "ramsey/conventional-commits": "^1.7",
        "roave/security-advisories": "dev-latest"
    },
    "provide": {
        "identifier/identifier-implementation": "*"
    },
    "suggest": {
        "psr/simple-cache-implementation": "To cache the system node (MAC address) for faster lookup"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ramsey\\Identifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ramsey\\Bench\\Identifier\\": "tests/bench/",
            "Ramsey\\Test\\Identifier\\": "tests/unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "phpstan/extension-installer": true,
            "ramsey/composer-repl": true
        },
        "sort-packages": true
    },
    "extra": {
        "captainhook": {
            "force-install": true
        },
        "ramsey/conventional-commits": {
            "configFile": "conventional-commits.json"
        }
    },
    "scripts": {
        "analyze": "vendor/bin/phpstan analyze --ansi -v --memory-limit=1G",
        "bench": "phpbench run --ansi --progress=dots --report=aggregate",
        "bench-ci": "phpbench run --ansi --progress=none --report=ci --output=artifact-tab --output=artifact-html",
        "bench-html": "phpbench run --ansi --progress=dots --report=ci --output=artifact-html",
        "coverage": [
            "git clean -fx build/coverage/.",
            "XDEBUG_MODE=coverage phpunit --colors=always --coverage-html build/coverage/coverage-html",
            "open build/coverage/coverage-html/index.html"
        ],
        "coverage-ci": "XDEBUG_MODE=coverage phpunit --colors=always --testdox --coverage-text --coverage-clover build/coverage/clover.xml",
        "fix": [
            "@composer normalize",
            "vendor/bin/phpcbf --cache=build/cache/phpcs.cache"
        ],
        "lint": [
            "@composer validate --strict",
            "@composer normalize --dry-run",
            "vendor/bin/phpcs --colors --cache=build/cache/phpcs.cache",
            "@analyze"
        ],
        "test": "vendor/bin/phpunit --colors=always"
    },
    "scripts-descriptions": {
        "analyze": "Runs static analysis.",
        "bench": "Runs benchmarks and shows an aggregate report.",
        "bench-ci": "Runs benchmarks and writes reports for continuous integration.",
        "bench-html": "Runs benchmarks and writes an HTML report.",
        "coverage": "Runs unit tests with code coverage analysis and opens the coverage report in a web browser.",
        "coverage-ci": "Runs unit tests with code coverage analysis and outputs a Clover XML file.",
        "fix": "Fixes coding standards violations and normalizes composer.json.",
        "lint": "Runs coding standards checks and static analysis.",
        "test": "Runs unit tests."
    }
}
